# ============ 百货通智能客服 环境变量模板 ============
# 使用方法：复制本文件为 .env，填入真实值。
# 注意：.env 含密钥，已被 .gitignore 排除，绝不提交 git。

# 阿里云百炼 API 密钥（LLM 生成 + 分类 + Embedding）
DASHSCOPE_API_KEY=sk-你的百炼密钥

# DeepSeek 密钥（仅评估脚本的裁判模型用，不跑评估可不填）
DEEPSEEK_API_KEY=

# LLM 模型与参数
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.1
EMBEDDING_MODEL=text-embedding-v2

# JWT 密钥：必须换成随机强值（生成方式见下方注释）
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=换成上面的随机串
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据库连接串（直装部署用；Docker 部署时由 compose 自动覆盖为容器内地址，
# 下面三项 POSTGRES_* 才是 Docker 模式实际生效的数据库配置）
DATABASE_URL=postgresql+asyncpg://用户:强密码@127.0.0.1:5432/ragdb

# PostgreSQL 容器（仅 Docker 部署用，密码必须强随机）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=换成强密码
POSTGRES_DB=ragdb

# 首次启动创建默认 admin 的初始密码（admin 已存在时忽略；上线后建议删除本行）
INITIAL_ADMIN_PASSWORD=换成强密码

# 客服系统
AGENT_WORK_START_HOUR=9
AGENT_WORK_END_HOUR=21
AGENT_ONLINE_WINDOW_MINUTES=5

# ChromaDB 向量库与上传文件目录（相对仓库根，无需修改）
CHROMA_PERSIST_DIR=./backend/chroma_db
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_SIZE=20971520

# 服务端口
BACKEND_PORT=8000
FRONTEND_PORT=5173

# 限频开关（上线安全修复：登录 5/分、注册 3/分、对话 10/分，按 IP）
RATE_LIMIT_ENABLED=true

# CORS 放行来源（逗号分隔；同源 nginx 反代时无需修改，
# 若前端用独立域名访问 API 则填真实域名，如 https://shop.example.com）
CORS_ORIGINS=http://localhost:5173,http://localhost:8501
